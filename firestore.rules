rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // 🛑 1. BLOQUEO MAESTRO (Denegación por defecto)
    // Ningún nodo del sistema operativo es accesible a menos que se especifique abajo.
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }
    // =====================================================================
    // 🎫 2. LÍNEA DE TICKETS (Operación General)
    // =====================================================================
    match /tickets/{ticketId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false; // Trazabilidad innegociable
    }
    // =====================================================================
    // 🏢 3. MATRIZ DE CLIENTES (CRM Base)
    // =====================================================================
    match /clientes/{clienteId} {
      // Cualquier operario logueado puede buscar clientes o crear nuevos desde la app
      allow read, create, update: if request.auth != null;

      // 🛡️ REGLA INDUSTRIAL: Se prohíbe la eliminación física para no
      // dejar tickets antiguos apuntando a un cliente fantasma.
      allow delete: if false;
    }
    // =====================================================================
    // 👤 4. MATRIZ DE USUARIOS Y ROLES
    // =====================================================================
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      // 🔧 FIX: antes "allow create: if false" bloqueaba siempre el alta de
      // operarios. La app crea el perfil justo después de
      // createUserWithEmailAndPassword, momento en el que request.auth.uid
      // YA es el uid del usuario recién creado — por eso se permite crear
      // (y actualizar) solo el propio documento, igual que ya hacía update.
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    // =====================================================================
    // ⚙️ 5. AUTÓMATAS CONTADORES (Metadatos)
    // =====================================================================
    match /metadata/contadores {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    match /configuracion/contador_tickets {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    // =====================================================================
    // 🛠️ 6. CATÁLOGO MAESTRO DE ACTIVIDADES Y REPUESTOS (Plan Maestro)
    // =====================================================================
    match /catalogo_actividades/{actividadId} {
      // Cualquier operario autenticado (técnicos en evaluación, taller, comerciales)
      // puede consultar el catálogo de actividades y repuestos
      allow read: if request.auth != null;

      // Modificación y eliminación restringida a Supervisores y Administradores
      allow create, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
    }

    // =====================================================================
    // 📦 7. INVENTARIO Y STOCK DE BODEGA
    // =====================================================================
    match /inventario_bodega/{itemId} {
      // Cualquier usuario autenticado (Bodega, Compras, Taller) puede leer el stock
      allow read: if request.auth != null;
      // Bodega, supervisor y admin pueden crear/actualizar stock masivo
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
    }

    // =====================================================================
    // 👨‍🔧 8. CATÁLOGO DE TÉCNICOS (Gestión de Taller)
    // =====================================================================
    match /catalogo_tecnicos/{tecnicoId} {
      // 👁️ Lectura: Cualquier usuario autenticado (supervisores, taller) puede ver la lista de técnicos
      allow read: if request.auth != null;

      // ✍️ Gestión: Solo Supervisores y Administradores pueden registrar, modificar o eliminar técnicos
      allow create, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
    }

    // =====================================================================
    // 📊 9. CATÁLOGO Y MATRIZ DE MÉTRICAS DE FALLA POR EQUIPO
    // =====================================================================
    match /catalogo_metricas_falla/{tipoEquipo} {
      // 👁️ Lectura: Cualquier usuario autenticado puede consultar las categorías y causas de falla
      allow read: if request.auth != null;

      // ✍️ Gestión: Solo Supervisores y Administradores pueden crear, modificar categorías o agregar razones
      allow create, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
    }
  }
}


