rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // 🛑 1. BLOQUEO MAESTRO (Denegación por defecto)
    // Ningún nodo del sistema operativo es accesible a menos que se especifique abajo.
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================================
    // 🎫 2. LÍNEA DE TICKETS (Operación General y Enlaces Temporales)
    // =====================================================================
    match /tickets/{ticketId} {
      // Búsquedas y listados protegidos solo para personal autenticado
      allow list, create: if request.auth != null;

      // Lectura puntual (get) y actualización de estados:
      // Permitido para personal autenticado y para confirmación de recepción vía enlace temporal
      allow get, update: if true;

      // Trazabilidad innegociable
      allow delete: if false;
    }

    // =====================================================================
    // 🔗 2.1 TOKENS DE RECEPCIÓN EXTERNA (Enlaces temporales de Bodega)
    // =====================================================================
    match /tokens_recepcion_externa/{token} {
      // Supervisores autenticados pueden crear tokens y listar o buscar órdenes
      allow create, list: if request.auth != null;

      // Cualquier técnico con el enlace exacto (token en URL) puede leer su orden
      allow get: if true;

      // Actualización (quemar el token al confirmar recepción física):
      // - Permitido a personal autenticado
      // - O al técnico externo consumiendo un token válido (usado pasa de false a true)
      allow update: if request.auth != null || (
        resource.data.usado == false && request.resource.data.usado == true
      );

      // Nunca se eliminan tokens para conservar auditoría
      allow delete: if false;
    }

    // =====================================================================
    // 🏢 3. MATRIZ DE CLIENTES (CRM Base)
    // =====================================================================
    match /clientes/{clienteId} {
      // Cualquier operario logueado puede buscar clientes o crear nuevos desde la app
      allow read, create, update: if request.auth != null;

      // 🛡️ REGLA INDUSTRIAL: Se prohíbe la eliminación física para no
      // dejar tickets antiguos apuntando a un cliente fantasma.
      allow delete: if false;
    }

    // =====================================================================
    // 👤 4. MATRIZ DE USUARIOS Y ROLES
    // =====================================================================
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      // Permite creación y actualización por el propio usuario (login, fcmTokens, registro)
      // o por administradores/supervisores para gestionar roles y permisos del personal
      allow create, update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
      allow delete: if false;
    }

    // =====================================================================
    // ⚙️ 5. AUTÓMATAS CONTADORES (Metadatos)
    // =====================================================================
    match /metadata/contadores {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    match /configuracion/contador_tickets {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    // =====================================================================
    // 🛠️ 6. CATÁLOGO MAESTRO DE ACTIVIDADES Y REPUESTOS (Plan Maestro)
    // =====================================================================
    match /catalogo_actividades/{actividadId} {
      // Cualquier operario autenticado (técnicos en evaluación, taller, comerciales)
      // puede consultar el catálogo de actividades y repuestos
      allow read: if request.auth != null;

      // Modificación y eliminación restringida a Supervisores y Administradores
      allow create, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
    }

    // =====================================================================
    // 📦 7. INVENTARIO Y STOCK DE BODEGA
    // =====================================================================
    match /inventario_bodega/{itemId} {
      // Cualquier usuario autenticado (Bodega, Compras, Taller) puede leer el stock
      allow read: if request.auth != null;
      // Bodega, supervisor y admin pueden crear/actualizar stock masivo
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
    }

    // =====================================================================
    // 👨‍🔧 8. CATÁLOGO DE TÉCNICOS (Gestión de Taller)
    // =====================================================================
    match /catalogo_tecnicos/{tecnicoId} {
      // 👁️ Lectura: Cualquier usuario autenticado (supervisores, taller) puede ver la lista de técnicos
      allow read: if request.auth != null;

      // ✍️ Gestión: Supervisores y Administradores, o el propio técnico enrolándose al registrar su cuenta
      allow create, update: if request.auth != null && (
        request.auth.uid == tecnicoId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
    }

    // =====================================================================
    // 📊 9. CATÁLOGO Y MATRIZ DE MÉTRICAS DE FALLA POR EQUIPO
    // =====================================================================
    match /catalogo_metricas_falla/{tipoEquipo} {
      // 👁️ Lectura: Cualquier usuario autenticado puede consultar las categorías y causas de falla
      allow read: if request.auth != null;

      // ✍️ Gestión: Solo Supervisores y Administradores pueden crear, modificar categorías o agregar razones
      allow create, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['supervisor', 'admin', 'SUPERVISOR', 'ADMIN']
      );
    }
  }
}


